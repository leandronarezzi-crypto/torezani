generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  ADMIN
  EDITOR
  VISUALIZADOR
}

enum StatusUsuario {
  PENDENTE
  APROVADO
  REJEITADO
}

enum TipoConfiguracao {
  MONOMOTOR
  BIMOTOR
}

enum PosicaoMotor {
  MONO
  BORE_BABOR @map("BORE/BABOR")
  ESTIBORDO
}

enum TipoIntervencao {
  CASCO
  PINTURA
}

enum StatusContrato {
  ATIVO
  ENCERRADO
  SUSPENSO
}

enum StatusReceita {
  RECEBIDO
  PENDENTE
  EM_ATRASO
}

enum TipoManutencao {
  PREVENTIVA
  PREDITIVA
  CORRETIVA
}

enum CategoriaDespesa {
  COMBUSTIVEL
  LUBRIFICANTES
  OLEO
  PECAS
  OFICINA
  ESTALEIRO
  MOTOR
  GERADOR
  BOMBAS
  ELETRICA
  HIDRAULICA
  ALIMENTACAO
  HOSPEDAGEM
  SALARIOS
  IMPOSTOS
  SEGURO
  DOCUMENTACAO
  MATERIAL_CONSUMO
  FERRAMENTAS
  TERCEIROS
  FRETES
  OUTROS
}

model Usuario {
  id        Int            @id @default(autoincrement())
  nome      String         @db.VarChar(100)
  email     String         @unique @db.VarChar(150)
  senhaHash String         @map("senha_hash") @db.VarChar(200)
  papel     Papel          @default(VISUALIZADOR)
  status    StatusUsuario  @default(PENDENTE)
  criadoEm  DateTime       @default(now()) @map("criado_em") @db.Timestamptz

  notificacoesLidas NotificationRead[]
  auditoriasCriadas Auditoria[]
  logsAlteracao     LogAlteracao[]
  execucoesRegistradas ExecucaoManutencao[]
  ordensServicoEmitidas OrdemServico[]

  @@map("usuario")
}

/// Trilha de auditoria: registra TODA operacao de escrita feita na API.
/// Nunca e apagada nem editada — e a prova de quem alterou o que e quando.
model LogAlteracao {
  id           Int      @id @default(autoincrement())
  usuarioId    Int?     @map("usuario_id")
  usuarioEmail String?  @map("usuario_email") @db.VarChar(150)
  usuarioPapel String?  @map("usuario_papel") @db.VarChar(20)
  metodo       String   @db.VarChar(10)
  rota         String   @db.VarChar(300)
  entidade     String?  @db.VarChar(60)
  registroId   String?  @map("registro_id") @db.VarChar(60)
  dados        Json?
  statusCode   Int      @map("status_code")
  sucesso      Boolean  @default(true)
  erro         String?
  ip           String?  @db.VarChar(60)
  duracaoMs    Int?     @map("duracao_ms")
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@index([criadoEm])
  @@index([entidade, registroId])
  @@map("log_alteracao")
}

model Embarcacao {
  id                      Int       @id @default(autoincrement())
  nome                    String    @db.VarChar(100)
  tipoConfiguracao        TipoConfiguracao @map("tipo_configuracao")
  latitude                Decimal?  @db.Decimal(9, 6)
  longitude               Decimal?  @db.Decimal(9, 6)
  localizacaoAtualizadaEm DateTime? @map("localizacao_atualizada_em") @db.Timestamptz
  criadoEm                DateTime  @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm            DateTime  @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz
  /// Exclusao logica: quando preenchido, a embarcacao some das telas mas
  /// NADA e apagado do banco (motores, manutencoes e historico continuam intactos).
  excluidoEm              DateTime? @map("excluido_em") @db.Timestamptz

  motores       Motor[]
  cascoPintura  ManutencaoCascoPintura[]
  auditorias    Auditoria[]
  despesas      Despesa[]
  receitas      Receita[]
  ordensServico OrdemServico[]

  @@index([excluidoEm])
  @@map("embarcacao")
}

model Motor {
  id             Int          @id @default(autoincrement())
  embarcacaoId   Int          @map("embarcacao_id")
  posicao        PosicaoMotor
  marca          String?      @db.VarChar(50)
  modelo         String?      @db.VarChar(50)
  potenciaConfig String?      @map("potencia_config") @db.VarChar(50)
  numSerie       String?      @map("num_serie") @db.VarChar(50)
  horimetroAtual Decimal      @default(0.00) @map("horimetro_atual") @db.Decimal(10, 2)
  criadoEm       DateTime     @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm   DateTime     @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz

  embarcacao        Embarcacao          @relation(fields: [embarcacaoId], references: [id], onDelete: Cascade)
  caixaReversora    CaixaReversora?
  sistemaEixoHelice SistemaEixoHelice?
  correias          Correia[]
  manutencoes       ManutencaoPreventiva[]
  ordensServico     OrdemServico[]

  @@index([embarcacaoId])
  @@map("motor")
}

model CaixaReversora {
  id           Int      @id @default(autoincrement())
  motorId      Int      @unique @map("motor_id")
  marca        String?  @db.VarChar(50)
  modelo       String?  @db.VarChar(50)
  ratio        String?  @db.VarChar(20)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz

  motor Motor @relation(fields: [motorId], references: [id], onDelete: Cascade)

  @@map("caixa_reversora")
}

model SistemaEixoHelice {
  id              Int      @id @default(autoincrement())
  motorId         Int      @unique @map("motor_id")
  diametroHelice  String?  @map("diametro_helice") @db.VarChar(50)
  passoHelice     String?  @map("passo_helice") @db.VarChar(50)
  numPas          Int?     @map("num_pas")
  diametroEixo    String?  @map("diametro_eixo") @db.VarChar(50)
  grauCone        String?  @map("grau_cone") @db.VarChar(50)
  comprimentoCone String?  @map("comprimento_cone") @db.VarChar(50)
  criadoEm        DateTime @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm    DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz

  motor Motor @relation(fields: [motorId], references: [id], onDelete: Cascade)

  @@map("sistema_eixo_helice")
}

model Correia {
  id                   Int      @id @default(autoincrement())
  motorId              Int      @map("motor_id")
  funcaoAplicacao      String?  @map("funcao_aplicacao") @db.VarChar(100)
  especificacaoTamanho String?  @map("especificacao_tamanho") @db.VarChar(50)
  quantidade           Int      @default(1)
  criadoEm             DateTime @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm         DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz

  motor Motor @relation(fields: [motorId], references: [id], onDelete: Cascade)

  @@index([motorId])
  @@map("correia")
}

model ManutencaoPreventiva {
  id                   Int             @id @default(autoincrement())
  motorId              Int             @map("motor_id")
  tipo                 TipoManutencao  @default(PREVENTIVA)
  tipoServico          String          @map("tipo_servico") @db.VarChar(255)
  horimetroUltimaTroca Decimal         @default(0.00) @map("horimetro_ultima_troca") @db.Decimal(10, 2)
  /// Obrigatorio para Preventiva (proxima troca) e Preditiva (proxima inspecao).
  /// Corretiva e evento pontual (reparo ja feito), sempre null.
  intervaloHoras       Int?            @map("intervalo_horas")
  alertaLimiteHoras    Int             @default(0) @map("alerta_limite_horas")
  criadoEm             DateTime        @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm         DateTime        @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz

  motor         Motor                @relation(fields: [motorId], references: [id], onDelete: Cascade)
  execucoes     ExecucaoManutencao[]
  ordensServico OrdemServico[]

  @@index([motorId])
  @@map("manutencao_preventiva")
}

/// Historico permanente de execucoes de manutencao.
/// Cada "Registrar Servico" gera uma linha aqui. NADA e sobrescrito nem apagado.
model ExecucaoManutencao {
  id                Int      @id @default(autoincrement())
  manutencaoId      Int      @map("manutencao_id")
  horimetro         Decimal  @db.Decimal(10, 2)
  dataExecucao      DateTime @map("data_execucao") @db.Timestamptz
  observacoes       String?
  /// REGISTRO = lancado pelo usuario | MESCLAGEM = recuperado de cadastro duplicado
  origem            String   @default("REGISTRO") @db.VarChar(20)
  registradoPorId   Int?     @map("registrado_por_id")
  registradoPorNome String?  @map("registrado_por_nome") @db.VarChar(150)
  /// Custo do servico (usado sobretudo em Preditiva/Corretiva). Se preenchido, gera uma Despesa automaticamente.
  custo             Decimal? @db.Decimal(12, 2)
  fornecedor        String?  @db.VarChar(150)
  despesaId         Int?     @unique @map("despesa_id")
  criadoEm          DateTime @default(now()) @map("criado_em") @db.Timestamptz

  manutencao    ManutencaoPreventiva @relation(fields: [manutencaoId], references: [id], onDelete: Cascade)
  registradoPor Usuario?             @relation(fields: [registradoPorId], references: [id], onDelete: SetNull)
  despesa       Despesa?             @relation(fields: [despesaId], references: [id], onDelete: SetNull)

  @@index([manutencaoId])
  @@index([dataExecucao])
  @@map("execucao_manutencao")
}

model ManutencaoCascoPintura {
  id                   Int             @id @default(autoincrement())
  embarcacaoId         Int             @map("embarcacao_id")
  tipoIntervencao      TipoIntervencao @map("tipo_intervencao")
  dataExecucao         DateTime?       @map("data_execucao") @db.Date
  horimetroEmbarcacao  Decimal?        @map("horimetro_embarcacao") @db.Decimal(10, 2)
  esquemaProdutos      String?         @map("esquema_produtos")
  historicoObservacoes String?         @map("historico_observacoes")
  alertaVencimentoData DateTime?       @map("alerta_vencimento_data") @db.Date
  criadoEm             DateTime        @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm         DateTime        @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz

  embarcacao Embarcacao @relation(fields: [embarcacaoId], references: [id], onDelete: Cascade)

  @@index([embarcacaoId])
  @@map("manutencao_casco_pintura")
}

// Rastreia quais notificações computadas (ver notifications.service) cada usuário já leu.
model NotificationRead {
  id             Int      @id @default(autoincrement())
  usuarioId      Int      @map("usuario_id")
  notificationId String   @map("notification_id") @db.VarChar(80)
  lidoEm         DateTime @default(now()) @map("lido_em") @db.Timestamptz

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, notificationId])
  @@map("notification_read")
}

// Auditoria de manutenção: checklist preenchido em campo, escalável para qualquer embarcação
// da frota. O modelo de itens (categoria + descrição) vem de checklist-template.ts; cada
// auditoria grava uma cópia própria dos itens (concluido/observação) no momento em que foi feita.
model Auditoria {
  id                Int       @id @default(autoincrement())
  embarcacaoId      Int       @map("embarcacao_id")
  responsavel       String    @db.VarChar(150)
  dataRealizacao    DateTime  @map("data_realizacao") @db.Date
  horimetro         Decimal?  @db.Decimal(10, 2)
  observacoesGerais String?   @map("observacoes_gerais")
  criadoPorId       Int?      @map("criado_por_id")
  criadoEm          DateTime  @default(now()) @map("criado_em") @db.Timestamptz

  embarcacao Embarcacao      @relation(fields: [embarcacaoId], references: [id], onDelete: Cascade)
  criadoPor  Usuario?        @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)
  itens      AuditoriaItem[]

  @@index([embarcacaoId])
  @@map("auditoria")
}

model AuditoriaItem {
  id          Int     @id @default(autoincrement())
  auditoriaId Int     @map("auditoria_id")
  categoria   String  @db.VarChar(50)
  descricao   String
  concluido   Boolean @default(false)
  observacao  String?
  ordem       Int     @default(0)

  auditoria Auditoria @relation(fields: [auditoriaId], references: [id], onDelete: Cascade)

  @@index([auditoriaId])
  @@map("auditoria_item")
}

// ---------------------------------------------------------------------------
// Financeiro — Fase 1: nucleo (clientes, contratos, centros de custo,
// despesas, receitas). Dashboard/KPIs/alertas/relatorios financeiros ficam
// para fases seguintes, que vao ler estes mesmos dados.
// ---------------------------------------------------------------------------

/// Exclusao logica: assim como Embarcacao, nunca apaga historico financeiro do banco.
model Cliente {
  id               Int       @id @default(autoincrement())
  nome             String    @db.VarChar(150)
  documento        String?   @db.VarChar(20)
  contatoNome      String?   @map("contato_nome") @db.VarChar(150)
  contatoEmail     String?   @map("contato_email") @db.VarChar(150)
  contatoTelefone  String?   @map("contato_telefone") @db.VarChar(30)
  observacoes      String?
  criadoEm         DateTime  @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm     DateTime  @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz
  excluidoEm       DateTime? @map("excluido_em") @db.Timestamptz

  contratos Contrato[]
  receitas  Receita[]

  @@index([excluidoEm])
  @@map("cliente")
}

model Contrato {
  id           Int             @id @default(autoincrement())
  clienteId    Int             @map("cliente_id")
  numero       String?         @db.VarChar(50)
  descricao    String?
  valor        Decimal?        @db.Decimal(12, 2)
  dataInicio   DateTime?       @map("data_inicio") @db.Date
  dataFim      DateTime?       @map("data_fim") @db.Date
  status       StatusContrato  @default(ATIVO)
  observacoes  String?
  criadoEm     DateTime        @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm DateTime        @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz
  excluidoEm   DateTime?       @map("excluido_em") @db.Timestamptz

  cliente  Cliente   @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  receitas Receita[]

  @@index([clienteId])
  @@index([excluidoEm])
  @@map("contrato")
}

/// Taxonomia de centros de custo (ex.: Operacao > Navegacao). Sem exclusao
/// logica: e uma tabela de apoio, removida so quando nao estiver em uso.
model CentroCusto {
  id           Int       @id @default(autoincrement())
  nome         String    @db.VarChar(100)
  paiId        Int?      @map("pai_id")
  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm DateTime  @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz

  pai      CentroCusto?  @relation("CentroCustoHierarquia", fields: [paiId], references: [id], onDelete: Restrict)
  filhos   CentroCusto[] @relation("CentroCustoHierarquia")
  despesas Despesa[]

  @@index([paiId])
  @@map("centro_custo")
}

model Despesa {
  id               Int              @id @default(autoincrement())
  categoria        CategoriaDespesa
  subcategoria     String?          @db.VarChar(100)
  embarcacaoId     Int?             @map("embarcacao_id")
  centroCustoId    Int?             @map("centro_custo_id")
  fornecedor       String?          @db.VarChar(150)
  numeroNotaFiscal String?          @map("numero_nota_fiscal") @db.VarChar(50)
  valor            Decimal          @db.Decimal(12, 2)
  data             DateTime         @db.Date
  formaPagamento   String?          @map("forma_pagamento") @db.VarChar(50)
  observacoes      String?
  criadoEm         DateTime         @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm     DateTime         @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz
  excluidoEm       DateTime?        @map("excluido_em") @db.Timestamptz

  embarcacao  Embarcacao?  @relation(fields: [embarcacaoId], references: [id], onDelete: SetNull)
  centroCusto CentroCusto? @relation(fields: [centroCustoId], references: [id], onDelete: SetNull)
  /// Preenchido quando a despesa foi gerada automaticamente por um registro de manutencao Preditiva/Corretiva.
  execucaoManutencao ExecucaoManutencao?

  @@index([embarcacaoId])
  @@index([centroCustoId])
  @@index([data])
  @@index([excluidoEm])
  @@map("despesa")
}

model Receita {
  id               Int           @id @default(autoincrement())
  clienteId        Int           @map("cliente_id")
  contratoId       Int?          @map("contrato_id")
  embarcacaoId     Int?          @map("embarcacao_id")
  tipoServico      String?       @map("tipo_servico") @db.VarChar(150)
  valorContratado  Decimal?      @map("valor_contratado") @db.Decimal(12, 2)
  valorFaturado    Decimal?      @map("valor_faturado") @db.Decimal(12, 2)
  valorRecebido    Decimal?      @map("valor_recebido") @db.Decimal(12, 2)
  data             DateTime      @db.Date
  status           StatusReceita @default(PENDENTE)
  observacoes      String?
  criadoEm         DateTime      @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm     DateTime      @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz
  excluidoEm       DateTime?     @map("excluido_em") @db.Timestamptz

  cliente    Cliente     @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  contrato   Contrato?   @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  embarcacao Embarcacao? @relation(fields: [embarcacaoId], references: [id], onDelete: SetNull)

  @@index([clienteId])
  @@index([contratoId])
  @@index([embarcacaoId])
  @@index([data])
  @@index([excluidoEm])
  @@map("receita")
}

/// Documento formal impresso ("formulario") pra encaminhar um servico de manutencao
/// (vencido ou nao) a quem for executa-lo. E um registro permanente — nunca editado
/// nem apagado — que fixa o numero (o proprio id) e o estado da manutencao no
/// momento da emissao, para servir de comprovante e evitar emissao duplicada.
model OrdemServico {
  id             Int            @id @default(autoincrement())
  manutencaoId   Int?           @map("manutencao_id")
  embarcacaoId   Int            @map("embarcacao_id")
  motorId        Int?           @map("motor_id")
  tipo           TipoManutencao
  tipoServico    String         @map("tipo_servico") @db.VarChar(255)
  horimetroAtual Decimal?       @map("horimetro_atual") @db.Decimal(10, 2)
  horasRestantes Int?           @map("horas_restantes")
  /// Snapshot do status (VENCIDO/ALERTA/OK/N-A) no momento da emissao.
  status         String         @db.VarChar(20)
  observacoes    String?
  emitidoPorId   Int?           @map("emitido_por_id")
  emitidoPorNome String?        @map("emitido_por_nome") @db.VarChar(150)
  criadoEm       DateTime       @default(now()) @map("criado_em") @db.Timestamptz

  manutencao ManutencaoPreventiva? @relation(fields: [manutencaoId], references: [id], onDelete: SetNull)
  embarcacao Embarcacao            @relation(fields: [embarcacaoId], references: [id], onDelete: Cascade)
  motor      Motor?                @relation(fields: [motorId], references: [id], onDelete: SetNull)
  emitidoPor Usuario?              @relation(fields: [emitidoPorId], references: [id], onDelete: SetNull)

  @@index([embarcacaoId])
  @@index([manutencaoId])
  @@index([criadoEm])
  @@map("ordem_servico")
}
